{
  "schemaVersion": 5,
  "target": {
    "processName": "knightonline.exe"
  },
  "macro": {
    "actions": [
      {
        "type": "If",
        "condition": {
          "source": "PlayerHP",
          "operator": "LessThan",
          "value": "2000"
        },
        "actions": [
          { "type": "Press", "value": "1", "durationMilliseconds": 75 }
        ]
      },
      {
        "type": "If",
        "condition": {
          "source": "PlayerMP",
          "operator": "LessThan",
          "value": "2000"
        },
        "actions": [
          { "type": "Press", "value": "3", "durationMilliseconds": 75 }
        ]
      },
      { "type": "Press", "value": "Z", "durationMilliseconds": 75 },
      {
        "type": "If",
        "condition": {
          "source": "CurrentMob",
          "operator": "Equals",
          "value": "Shadow Seeker"
        },
        "actions": [
          { "type": "Press", "value": "R", "durationMilliseconds": 75 },
          { "type": "Wait", "value": "250" },
          { "type": "Press", "value": "2", "durationMilliseconds": 75 },
          { "type": "Wait", "value": "250" },
          { "type": "Press", "value": "2", "durationMilliseconds": 75 },
          { "type": "Wait", "value": "250" },
          { "type": "Press", "value": "2", "durationMilliseconds": 75 }
        ],
        "elseActions": [
          {
            "type": "If",
            "condition": {
              "source": "CurrentMob",
              "operator": "Equals",
              "value": "Battalion"
            },
            "actions": [
              { "type": "Press", "value": "R", "durationMilliseconds": 75 },
              { "type": "Wait", "value": "250" },
              { "type": "Press", "value": "2", "durationMilliseconds": 75 },
              { "type": "Wait", "value": "250" },
              { "type": "Press", "value": "2", "durationMilliseconds": 75 },
              { "type": "Wait", "value": "250" },
              { "type": "Press", "value": "2", "durationMilliseconds": 75 }
            ],
            "elseActions": [
              {
                "type": "If",
                "condition": {
                  "source": "CurrentMob",
                  "operator": "Equals",
                  "value": "[Field Boss] Byzombie"
                },
                "actions": [
                  { "type": "Press", "value": "R", "durationMilliseconds": 75 },
                  { "type": "Wait", "value": "250" },
                  { "type": "Press", "value": "2", "durationMilliseconds": 75 },
                  { "type": "Wait", "value": "250" },
                  { "type": "Press", "value": "2", "durationMilliseconds": 75 },
                  { "type": "Wait", "value": "250" },
                  { "type": "Press", "value": "2", "durationMilliseconds": 75 }
                ],
                "elseActions": [
                  {
                    "type": "If",
                    "condition": {
                      "source": "CurrentMob",
                      "operator": "Equals",
                      "value": "Wild Smilodon"
                    },
                    "actions": [
                      { "type": "Press", "value": "R", "durationMilliseconds": 75 },
                      { "type": "Wait", "value": "250" },
                      { "type": "Press", "value": "2", "durationMilliseconds": 75 },
                      { "type": "Wait", "value": "250" },
                      { "type": "Press", "value": "2", "durationMilliseconds": 75 },
                      { "type": "Wait", "value": "250" },
                      { "type": "Press", "value": "2", "durationMilliseconds": 75 }
                    ],
                    "elseActions": [
                      { "type": "Press", "value": "S", "durationMilliseconds": 1000 }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      { "type": "Wait", "value": "500" }
    ]
  }
}
